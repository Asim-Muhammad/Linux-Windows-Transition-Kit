#!/usr/bin/env python3
import sys
import os

# Resolve symlinks so real package directory is found
REAL_PATH = os.path.realpath(os.path.abspath(__file__))
BASE_DIR = os.path.dirname(os.path.dirname(REAL_PATH))
if BASE_DIR not in sys.path:
    sys.path.insert(0, BASE_DIR)

from netdoctor.app import main

if __name__ == "__main__":
    sys.exit(main())
